# Maanak Drishti - Digital Legal Metrology Backend Configuration
# Environment settings for FastAPI and MySQL 8

APP_NAME="Maanak Drishti - Digital Legal Metrology"
APP_VERSION="1.0.0"
DEBUG=true

# Server Configuration
HOST=127.0.0.1
PORT=8000

# CORS Origins (comma-separated)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000"

# MySQL 8 Database Configuration
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database>
# If MySQL is not running or unreachable, backend gracefully falls back to local SQLite database.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=maanak_drishti

# Database URL override (Optional)
# DATABASE_URL=mysql+pymysql://root:root@127.0.0.1:3306/maanak_drishti
